# ==============================================================================
# BUKAR DATA SUB — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on your live production server and populate with your credentials.

# Application Core
NODE_ENV=production
PORT=5000
APP_NAME="Bukar Data Sub"
SUPPORT_EMAIL=support@bukardatasub.com
DEFAULT_CURRENCY=NGN

# Database Configuration
# SQLite WAL mode database path on server
DB_PATH=./data/platform.sqlite

# Security & Authentication
# Generate a strong 64-character secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_jwt_secret_hex_key_64_chars_min
ENCRYPTION_KEY=replace_with_32_byte_aes_encryption_key_in_hex_format

# CORS Security (set to your exact domain in production)
CORS_ORIGIN=https://bukardatasub.com,https://www.bukardatasub.com

# Payment Gateways (Optional in test mode, required for live payments)
# Paystack Live API Keys
PAYSTACK_SECRET_KEY=bds_paystack_secret_key_placeholder
PAYSTACK_PUBLIC_KEY=bds_paystack_public_key_placeholder
PAYSTACK_WEBHOOK_SECRET=bds_paystack_webhook_secret_placeholder

# Monnify Live API Keys (Virtual Accounts & Direct Debit)
MONNIFY_API_KEY=bds_monnify_api_key_placeholder
MONNIFY_SECRET_KEY=bds_monnify_secret_key_placeholder
MONNIFY_CONTRACT_CODE=bds_monnify_contract_code_placeholder

# PalmPay Live API Keys
PALMPAY_APP_ID=bds_palmpay_app_id_placeholder
PALMPAY_APP_SECRET=bds_palmpay_app_secret_placeholder

# Flutterwave Live API Keys
FLUTTERWAVE_SECRET_KEY=bds_flutterwave_secret_key_placeholder
FLUTTERWAVE_PUBLIC_KEY=bds_flutterwave_public_key_placeholder
FLUTTERWAVE_SECRET_HASH=bds_flutterwave_secret_hash_placeholder

# VTU & Telecom Providers
# VTPass API
VTPASS_API_KEY=xxxxxxxxxxxxxxxxxxxx
VTPASS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx
VTPASS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# Clubkonnect API
CLUBKONNECT_USER_ID=CKxxxxxxxx
CLUBKONNECT_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Topupmate / MobileAirtime API
TOPUPMATE_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Transaction & Wallet Controls
DAILY_MAX_DEPOSIT_LIMIT=5000000
DAILY_MAX_WITHDRAWAL_LIMIT=1000000
MIN_TRANSFER_AMOUNT=100
MAX_TRANSFER_AMOUNT=500000
MIN_WALLET_FUNDING=100

# SMTP / Email Alerts (Brevo, SendGrid, Amazon SES, or Hostinger SMTP)
SMTP_HOST=smtp.bukardatasub.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@bukardatasub.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM_NAME="Bukar Data Sub Notifications"
SMTP_FROM_EMAIL=noreply@bukardatasub.com

# Maintenance Mode (false by default)
MAINTENANCE_MODE=false
